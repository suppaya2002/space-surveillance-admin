datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum UserStatus {
  PENDING
  ACTIVE
}

enum OfficerCategory {
  COMMISSIONED     // สัญญาบัตร
  NON_COMMISSIONED // ประทวน
}

enum LeaveType {
  VACATION // ลาพักผ่อน
  BUSINESS // ลากิจ
  SICK     // ลาป่วย
  OTHER    // อื่นๆ
}

enum MissionLocation {
  SAM_MO      // สฝอว.สม.
  DON_MUEANG  // สฝอว.ดน.
  OTHER       // ราชการอื่นๆ
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String?          // Google display name
  rank         String?          // ยศ เช่น จ.อ., น.ต.
  firstName    String?          // ชื่อจริง
  lastName     String?          // นามสกุลจริง
  category     OfficerCategory?
  role         Role             @default(USER)
  status       UserStatus       @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  leaves       LeaveRecord[]
  missionStaff MissionStaff[]
  dutyStaff    DutyStaff[]
}

model LeaveRecord {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType  LeaveType
  startDate  DateTime
  endDate    DateTime
  reason     String?
  isApproved Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

model MissionBatch {
  id          String          @id @default(cuid())
  batchNumber Int
  year        Int             // ปี พ.ศ. เช่น 2569
  location    MissionLocation
  otherDetail String?
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime        @default(now())
  staffs      MissionStaff[]
}

model MissionStaff {
  id        String       @id @default(cuid())
  batchId   String
  batch     MissionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DutyType {
  id           String           @id @default(cuid())
  name         String           // เช่น เวรนำแถว, เวรบรรยายสรุป, เวรพูดหน้าแถว
  requiredType OfficerCategory? // สัญญาบัตร / ประทวน หรือ null หากเป็นใครก็ได้
  mainCount    Int              @default(1)
  backupCount  Int              @default(1)
  schedules    DutySchedule[]
}

model DutySchedule {
  id         String      @id @default(cuid())
  dutyTypeId String
  dutyType   DutyType    @relation(fields: [dutyTypeId], references: [id], onDelete: Cascade)
  dutyDate   DateTime
  createdAt  DateTime    @default(now())
  staffs     DutyStaff[]
}

model DutyStaff {
  id         String       @id @default(cuid())
  scheduleId String
  schedule   DutySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isBackup   Boolean      @default(false)
}