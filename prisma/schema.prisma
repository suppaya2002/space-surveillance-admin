datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  firstName     String?
  lastName      String?
  rank          String?
  role          String         @default("USER")
  status        String         @default("PENDING")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  missionStaffs MissionStaff[]
}

model MissionBatch {
  id          String         @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  documentUrl String?
  staffs      MissionStaff[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model MissionStaff {
  id             String       @id @default(cuid())
  missionBatchId String
  missionBatch   MissionBatch @relation(fields: [missionBatchId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}