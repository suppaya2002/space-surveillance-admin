datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RankType {
  COMMISSIONED     // สัญญาบัตร
  NON_COMMISSIONED // ประทวน
}

enum DutyStation {
  SURAT_THANI // สฝอว.สม.
  DON_MUEANG  // สฝอว.ดน.
  OTHER       // ราชการอื่นๆ
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?     // ชื่อจาก Google
  officialName  String?     // ยศ-ชื่อ-นามสกุล ที่แอดมินกำหนด
  rankType      RankType?
  role          Role        @default(USER)
  status        UserStatus  @default(PENDING)
  createdAt     DateTime    @default(now())
  leaves        LeaveRequest[]
  dutyAssignees DutyAssignment[]
  deployments   DeploymentMember[]
}

model LeaveRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  leaveType   String    // ลาพักผ่อน, ลากิจ, ลาป่วย ฯลฯ
  startDate   DateTime
  endDate     DateTime
  reason      String?
  isApproved  Boolean   @default(false)
  approvedBy  String?
  createdAt   DateTime  @default(now())
}

model Deployment {
  id          String             @id @default(cuid())
  station     DutyStation
  batchNumber Int                // ลำดับผลัด
  yearBe      Int                // ปี พ.ศ.
  startDate   DateTime
  endDate     DateTime
  description String?
  members     DeploymentMember[]
}

model DeploymentMember {
  id           String     @id @default(cuid())
  deploymentId String
  userId       String
  deployment   Deployment @relation(fields: [deploymentId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
}

model TaskType {
  id              String         @id @default(cuid())
  name            String         // เช่น เวรนำแถว, เวรบรรยายสรุป
  allowedRankType RankType?      // กรองเฉพาะสัญญาบัตร หรือ ประทวน (null คือได้ทั้งหมด)
  duties          DutySchedule[]
}

model DutySchedule {
  id          String           @id @default(cuid())
  taskTypeId  String
  taskType    TaskType         @relation(fields: [taskTypeId], references: [id])
  date        DateTime
  assignments DutyAssignment[]
}

model DutyAssignment {
  id             String       @id @default(cuid())
  dutyScheduleId String
  dutySchedule   DutySchedule @relation(fields: [dutyScheduleId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  isPrimary      Boolean      @default(true) // true = ตัวจริง, false = ตัวสำรอง
}